# ServerDeck Environment Configuration Template
# Copy this file to .env or /etc/serverdeck/.env and populate your secrets.

# System & Runtime Paths
SERVERDECK_ENV=production
SERVERDECK_CONFIG_DIR=/etc/serverdeck
SERVERDECK_DATA_DIR=/var/lib/serverdeck

# Discord Bot Authentication (Keep Secret!)
# Obtain your Bot Token from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Discord Webhook Integration
# Format: https://discord.com/api/webhooks/<WEBHOOK_ID>/<WEBHOOK_TOKEN>
DISCORD_WEBHOOK_URL=

# Discord Channel & Security IDs (Integers)
# Right-click channel/user in Discord with Developer Mode enabled to copy IDs
DISCORD_STATUS_CHANNEL_ID=0
DISCORD_ALERTS_CHANNEL_ID=0
DISCORD_ALLOWED_USER_IDS=

# Resource Alert Thresholds (1.0 - 100.0 %)
ALERT_CPU_PERCENT=90.0
ALERT_RAM_PERCENT=90.0
ALERT_DISK_PERCENT=90.0
ALERT_TEMP_CELSIUS=80.0

